# Independent synthetic EX/ELS campus fabric
set version 21.4R3.15
set system host-name CORPUS-EX
# Model: EX4300-48T
set system name-server 192.0.2.53
set protocols rstp
set interfaces ge-0/0/0 ether-options 802.3ad ae0
set interfaces ge-0/0/1 ether-options 802.3ad ae0
set interfaces ae0 aggregated-ether-options lacp active
set interfaces ae0 unit 0 family ethernet-switching interface-mode trunk
set vlans SEG10 vlan-id 10
set vlans SEG10 l3-interface irb.10
set interfaces ae0 unit 0 family ethernet-switching vlan members SEG10
set interfaces irb unit 10 family inet address 192.0.2.10/32
set interfaces ge-0/0/10 description "Access segment 10"
set interfaces ge-0/0/10 unit 0 family ethernet-switching interface-mode access
set interfaces ge-0/0/10 unit 0 family ethernet-switching vlan members SEG10
set vlans SEG20 vlan-id 20
set vlans SEG20 l3-interface irb.20
set interfaces ae0 unit 0 family ethernet-switching vlan members SEG20
set interfaces irb unit 20 family inet address 192.0.2.20/32
set interfaces ge-0/0/20 description "Access segment 20"
set interfaces ge-0/0/20 unit 0 family ethernet-switching interface-mode access
set interfaces ge-0/0/20 unit 0 family ethernet-switching vlan members SEG20
set vlans SEG30 vlan-id 30
set vlans SEG30 l3-interface irb.30
set interfaces ae0 unit 0 family ethernet-switching vlan members SEG30
set interfaces irb unit 30 family inet address 192.0.2.30/32
set interfaces ge-0/0/30 description "Access segment 30"
set interfaces ge-0/0/30 unit 0 family ethernet-switching interface-mode access
set interfaces ge-0/0/30 unit 0 family ethernet-switching vlan members SEG30
set routing-instances BLUE instance-type virtual-router
set routing-instances BLUE interface irb.20
set routing-instances BLUE routing-options static route 198.51.100.20/32 next-hop 192.0.2.254
set routing-instances GREEN instance-type virtual-router
set routing-instances GREEN interface irb.30
set routing-instances GREEN routing-options static route 198.51.100.30/32 next-hop 192.0.2.254
set routing-options static route 0.0.0.0/0 next-hop 192.0.2.254
set routing-options autonomous-system 64512
set protocols bgp group TRANSIT neighbor 203.0.113.2 peer-as 64513
