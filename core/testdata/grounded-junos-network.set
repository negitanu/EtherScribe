# Independent synthetic fixture, official Junos configuration statements
set system host-name GROUNDED-EX
# Model: EX4300-48T
set interfaces ge-0/0/0 ether-options 802.3ad ae0
set interfaces ge-0/0/1 ether-options 802.3ad ae1
set interfaces ae1 aggregated-ether-options lacp passive
set interfaces ae0 unit 0 family ethernet-switching vlan members [ BLUE GREEN ]
set interfaces ae0 unit 0 family ethernet-switching interface-mode trunk
set interfaces ge-0/0/2 disable
set interfaces irb unit 10 family inet address 192.0.2.1/24
set interfaces irb unit 10 family inet address 198.51.100.1/24
set interfaces irb unit 10 family inet6 address 2001:db8:10::1/64
set vlans BLUE vlan-id 10
set vlans GREEN vlan-id 20
set routing-options router-id 192.0.2.1
set routing-options autonomous-system 64512
set routing-options static route 203.0.113.0/24 metric 7
set routing-options static route 203.0.113.0/24 next-hop 192.0.2.2
set routing-options static route 203.0.113.0/24 preference 8
set routing-options static route 203.0.113.0/24 qualified-next-hop 192.0.2.3 preference 25
set routing-options static route 203.0.113.0/24 qualified-next-hop 192.0.2.3 metric 9
set routing-options static route 203.0.113.0/24 description "primary and backup"
set routing-options static route 198.51.100.0/24 discard
set routing-options static route 192.0.2.80/32 next-hop 192.0.2.2
set protocols bgp import [ BASE-IN SANITY ]
set protocols bgp group WAN neighbor 203.0.113.2 description "transit & backup"
set protocols bgp group WAN neighbor 203.0.113.2 peer-as 64514
set protocols bgp group WAN neighbor 203.0.113.3
set protocols bgp group WAN peer-as 64513
set protocols bgp group WAN local-address 192.0.2.1
set protocols bgp group WAN local-as 64515
set protocols bgp group WAN export [ EXPORT-A EXPORT-B ]
set protocols bgp group OFF peer-as 64516
set protocols bgp group OFF neighbor 203.0.113.4
set routing-instances BLUE instance-type virtual-router
set routing-instances BLUE interface irb.10
set routing-instances BLUE routing-options autonomous-system 64517
set routing-instances BLUE protocols bgp group IBGP type internal
set routing-instances BLUE protocols bgp group IBGP neighbor 192.0.2.9
set routing-instances BLUE routing-options static route 203.0.113.0/24 next-hop 192.0.2.9
set routing-instances BLUE routing-options static route 203.0.113.0/24 preference 30
deactivate protocols bgp group OFF
deactivate routing-options static route 192.0.2.80/32
