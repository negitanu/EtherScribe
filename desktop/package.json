{
  "name": "etherscribe",
  "productName": "EtherScribe",
  "version": "1.0.0",
  "private": true,
  "description": "Firewall parameter sheet desktop tool",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "build:engine": "node ../scripts/build-engine.mjs",
    "build:electron": "tsc -p tsconfig.electron.json",
    "dev": "npm run build:engine && npm run build:electron && vite",
    "build": "npm run build:engine && npm run build:ui",
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "pack": "npm run build && electron-builder --dir",
    "build:ui": "vite build && npm run build:electron",
    "release:mac": "electron-builder --mac zip dmg --arm64 --publish never",
    "release:win": "electron-builder --win zip --x64 --publish never"
  },
  "build": {
    "appId": "com.negitanu.etherscribe",
    "productName": "EtherScribe",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "resources/engine",
        "to": "engine",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../core/third_party/text/LICENSE",
        "to": "licenses/golang-x-text-LICENSE.txt"
      },
      {
        "from": "../core/third_party/text/PATENTS",
        "to": "licenses/golang-x-text-PATENTS.txt"
      },
      {
        "from": "../core/third_party/go/LICENSE",
        "to": "licenses/Go-LICENSE.txt"
      }
    ],
    "mac": {
      "target": [
        "dir"
      ],
      "identity": null,
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": [
        "dir"
      ],
      "signAndEditExecutable": false
    },
    "linux": {
      "target": [
        "dir"
      ]
    },
    "artifactName": "EtherScribe-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "afterPack": "../scripts/sign-mac.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.25.12": true
  }
}
