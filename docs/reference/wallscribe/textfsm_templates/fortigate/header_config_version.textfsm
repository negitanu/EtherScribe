Value MODEL_PREFIX (FGT|FG)
Value MODEL_CODE ([A-Z0-9]+)
Value OS_VERSION (\d+(?:\.\d+){1,3})
Value BUILD (\d+)
Value OPMODE (\d+)
Value VDOM (\d+)

Start
  ^\#config-version=${MODEL_PREFIX}${MODEL_CODE}-${OS_VERSION}-FW-build${BUILD}(?:-[0-9]+)?:opmode=${OPMODE}:vdom=${VDOM}.* -> Record
  ^\#config-version=${MODEL_PREFIX}${MODEL_CODE}-${OS_VERSION}-FW-build${BUILD}.* -> Record
  ^\#config-version=${MODEL_PREFIX}${MODEL_CODE}-${OS_VERSION}-FW.* -> Record
